# Shape of the configuration, without a single value. scripts/apply-secrets.sh turns this into .env by replacing
# every placeholder below with the environment variable of the same name — from GitHub secrets in a deploy, from
# the operator's shell in a manual rollout. The .env it produces is gitignored and stays on the host.
#
# (The placeholder syntax is deliberately not spelled out here: the script scans this file for it, and an example
# in a comment would be substituted like a real one. It found exactly that on the first run.)

# --- target store -------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=#{PA_POSTGRES_PASSWORD}#

# --- source: the business-event journal, READ ONLY -----------------------------------------------------------------
# Needs a dedicated login with db_datareader on dbo.BusinessEvents, dbo.BusinessEventObjects and the directory
# tables, and DENY INSERT/UPDATE/DELETE on everything. ApplicationIntent=ReadOnly is mandatory — without it the
# reader refuses to construct, which is the point: read-only has to be a property of the connection, not a promise.
SOURCE_CONNECTION_STRING=#{PA_SOURCE_CONNECTION_STRING}#

# --- pull tuning --------------------------------------------------------------------------------------------
PULL_INTERVAL_SECONDS=60
LAG_SECONDS=120
BATCH_SIZE=5000
MAX_PAGES_PER_RUN=40
GAP_SWEEP_DAYS=3
ALLOW_WRITE_CAPABLE_LOGIN=false

# --- what people see ----------------------------------------------------------------------------------------
# Names instead of pseudonyms. Deliberate decision, not a default.
SHOW_ACTOR_IDENTITY=#{PA_SHOW_ACTOR_IDENTITY}#
# Password in front of the dashboard. Generate the hash: docker compose run --rm processanalyzer hash-password
# With the login on and no hash the application refuses to start — a sign-in that cannot check anything is worse than
# none, because it looks like protection.
DASHBOARD_PASSWORD_HASH=#{PA_DASHBOARD_PASSWORD_HASH}#
# The sign-in itself. Off is defensible on ONE condition: the port is bound to loopback (PA_BIND below), so the only
# reader is somebody already sitting at this machine. A published port plus no login means everybody on the network
# can read who did what, by name.
REQUIRE_LOGIN=true
# Which address the port is published on. 127.0.0.1 = this machine only. 0.0.0.0 = the whole network, and then the
# login is not optional.
PA_BIND=127.0.0.1
# Stable across restarts: rotating it changes every pseudonym and breaks the continuity of every statistic that
# was computed before the change.
ACTOR_HASH_KEY=#{PA_ACTOR_HASH_KEY}#

# --- runtime ------------------------------------------------------------------------------------------------
PROCESSANALYZER_IMAGE=ghcr.io/codingsteve01/processanalyzer:latest
# Released with the same version as the application: the two agree on the shape of the OCEL file they exchange.
PROCESSANALYZER_MINER_IMAGE=ghcr.io/codingsteve01/processanalyzer-miner:latest
PROCESSANALYZER_PULL_POLICY=missing
PROCESSANALYZER_ARTIFACTS=./artifacts
# What the screens say: labels, discriminator rules, the payload allowlist and the type catalogue. Read at
# startup, so a corrected word needs a restart and no release. Defaults to the committed example, which
# describes an invented source — an installation points this at its own four files.
PROCESSANALYZER_VOCABULARY=./vocabulary.example
TZ=Europe/Berlin
