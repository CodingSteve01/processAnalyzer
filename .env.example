# === ProcessAnalyzer Environment Configuration ===
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is in .gitignore and will never be committed. This file must stay free of
# host names, logins and passwords — it is public.

# PostgreSQL (the mirror database this app owns).
# Any value works, it is local to the compose stack — but it must not be empty.
POSTGRES_PASSWORD=

# Source database (SQL Server) — READ ONLY.
# Requires a dedicated login that is db_datareader and nothing more, with SELECT
# narrowed to the two journal tables. Add ApplicationIntent=ReadOnly so the driver
# routes to a replica where one exists and fails fast if the app ever tries to write.
# The password belongs in .env only, never in this file, never in appsettings.json.
# Shape (fill in your own values):
#   Server=<host>;Database=<db>;User Id=<login>;Password=<secret>;
#   ApplicationIntent=ReadOnly;Encrypt=true;TrustServerCertificate=true
SOURCE_CONNECTION_STRING=

# Pull loop.
# PULL_INTERVAL_SECONDS  how often the loop wakes up
# LAG_SECONDS            rows younger than this are held back until the next run,
#                        because commit order and id order are not the same thing
# BATCH_SIZE             rows per page
# MAX_PAGES_PER_RUN      caps one run so a backlog cannot monopolise the source
PULL_INTERVAL_SECONDS=60
LAG_SECONDS=120
BATCH_SIZE=5000
MAX_PAGES_PER_RUN=40

# Gap sweep: re-checks the last N days for events the watermark walked past.
GAP_SWEEP_DAYS=3

# Guard rail: startup aborts if the source login turns out to be write-capable.
# Only set true against a throwaway local copy of the source.
ALLOW_WRITE_CAPABLE_LOGIN=false

# Container image configuration:
# - Default: local image (safer for active development)
# - To use GHCR latest, set:
#   PROCESSANALYZER_IMAGE=ghcr.io/codingsteve01/processanalyzer:latest
#   PROCESSANALYZER_PULL_POLICY=always
PROCESSANALYZER_IMAGE=ghcr.io/codingsteve01/processanalyzer:local
PROCESSANALYZER_PULL_POLICY=never

# Timezone of the app container.
TZ=Europe/Berlin
